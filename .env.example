# ===== WAJIB =====

# Telegram Bot Token (dari @BotFather)
BOT_TOKEN=your_bot_token_here

# Chat ID pemilik bot (dapatkan dari @userinfobot di Telegram)
CHAT_ID=your_chat_id_here

# Owner ID — chat ID yang bisa akses command admin (/setenv, /restart, /stats)
# Jika tidak di-set, akan fallback ke CHAT_ID
OWNER_ID=your_chat_id_here

# ===== FPL =====

# FPL ID kamu (untuk /squad dan /suggest tanpa ketik ID)
FPL_ID=your_fpl_id_here

# FPL login credentials (untuk fitur live squad sebelum deadline)
# Opsional — squad tetap bisa dilihat setelah deadline tanpa login
FPL_EMAIL=your_fpl_email
FPL_PASSWORD=your_fpl_password

# ===== OPSIONAL =====

# Port untuk health check server (default 3000)
PORT=3000

# Akun sumber berita X/Twitter (username tanpa @, pisahkan dengan koma)
# Default: OfficialFPL,FPLStatus,BenCrellin,FFScout,FPL_Rockstar
X_ACCOUNTS=

# Akun sumber berita Instagram (username tanpa @, pisahkan dengan koma)
# Default: officialfpl,premierleague,fantasyfootballscout,faborefpl,fpl.focal
IG_ACCOUNTS=

# Metrik scoring custom (biasanya dikelola via /metrics di bot)
METRICS_ACTIVE=
METRICS_WEIGHTS=

# Instagram session ID (opsional, untuk fetch IG yang lebih stabil)
IG_SESSION_ID=

# Admin secret untuk verifikasi command sensitif (Telegram bot)
ADMIN_SECRET=

# Admin Key untuk panel web admin (/admin.html)
ADMIN_KEY=your_admin_key_here

# Auth secret untuk token signing web app (auto-generated jika kosong)
AUTH_SECRET=

# Webhook secret untuk Telegram webhook (auto-generated jika kosong, tapi disarankan di-set agar persisten antar restart)
WEBHOOK_SECRET=
